{
  "multipart": [
    { "when": { "north": "false" }, "apply": { "model": "hydrofarm:block/energy_cell_face" } },
    { "when": { "east":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_face", "y": 90  } },
    { "when": { "south": "false" }, "apply": { "model": "hydrofarm:block/energy_cell_face", "y": 180 } },
    { "when": { "west":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_face", "y": 270 } },
    { "when": { "up":    "false" }, "apply": { "model": "hydrofarm:block/energy_cell_face", "x": 270 } },
    { "when": { "down":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_face", "x": 90  } },

    { "when": { "down":  "false", "north": "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h" } },
    { "when": { "down":  "false", "east":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "y": 90  } },
    { "when": { "down":  "false", "south": "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "y": 180 } },
    { "when": { "down":  "false", "west":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "y": 270 } },
    { "when": { "up":    "false", "south": "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "x": 180 } },
    { "when": { "up":    "false", "west":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "x": 180, "y": 90  } },
    { "when": { "up":    "false", "north": "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "x": 180, "y": 180 } },
    { "when": { "up":    "false", "east":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_h", "x": 180, "y": 270 } },

    { "when": { "north": "false", "west":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_v" } },
    { "when": { "north": "false", "east":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_v", "y": 90  } },
    { "when": { "south": "false", "east":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_v", "y": 180 } },
    { "when": { "south": "false", "west":  "false" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_v", "y": 270 } },

    { "when": { "down": "false", "north": "false", "west":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap" } },
    { "when": { "down": "false", "north": "false", "east":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "y": 90  } },
    { "when": { "down": "false", "east":  "false", "north": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "y": 90  } },
    { "when": { "down": "false", "east":  "false", "south": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "y": 180 } },
    { "when": { "down": "false", "south": "false", "east":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "y": 180 } },
    { "when": { "down": "false", "south": "false", "west":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "y": 270 } },
    { "when": { "down": "false", "west":  "false", "south": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "y": 270 } },
    { "when": { "down": "false", "west":  "false", "north": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap" } },

    { "when": { "up": "false", "south": "false", "west":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180 } },
    { "when": { "up": "false", "south": "false", "east":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180, "y": 270 } },
    { "when": { "up": "false", "west":  "false", "north": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180, "y": 90  } },
    { "when": { "up": "false", "west":  "false", "south": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180 } },
    { "when": { "up": "false", "north": "false", "east":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180, "y": 180 } },
    { "when": { "up": "false", "north": "false", "west":  "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180, "y": 90  } },
    { "when": { "up": "false", "east":  "false", "south": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180, "y": 270 } },
    { "when": { "up": "false", "east":  "false", "north": "true" }, "apply": { "model": "hydrofarm:block/energy_cell_edge_cap", "x": 180, "y": 180 } }
  ]
}
